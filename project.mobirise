{
  "settings": {
    "currentPage": "index.html",
    "theme": {
      "name": "mobirise5",
      "title": "Mobirise 5",
      "styling": {
        "primaryColor": "#06141f",
        "secondaryColor": "#dab989",
        "successColor": "#78dbe7",
        "infoColor": "#4f8495",
        "warningColor": "#9bb7bd",
        "dangerColor": "#a84949",
        "mainFont": "DM Sans",
        "display1Font": "Space Grotesk",
        "display1Size": 4.4,
        "display2Font": "Space Grotesk",
        "display2Size": 2.4,
        "display5Font": "Space Grotesk",
        "display5Size": 1.6,
        "display7Font": "DM Sans",
        "display7Size": 1.1,
        "display4Font": "DM Sans",
        "display4Size": 1,
        "isRoundedButtons": false,
        "isGhostButtonBorder": true,
        "underlinedLinks": false,
        "isAnimatedOnScroll": false,
        "isScrollToTopButton": false
      }
    },
    "path": "@PROJECT_PATH@",
    "name": "WAARD Blueprint Studio — Mobirise 6",
    "versionFirst": "5.9",
    "versionPublish": "6.0.5",
    "siteFonts": [
      {
        "css": "'DM Sans', 'Segoe UI', Arial, sans-serif",
        "name": "DM Sans",
        "url": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
      },
      {
        "css": "'Space Grotesk', 'Segoe UI', Arial, sans-serif",
        "name": "Space Grotesk",
        "url": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      },
      {
        "css": "'IBM Plex Mono', Consolas, monospace",
        "name": "IBM Plex Mono",
        "url": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      }
    ],
    "imageResize": true,
    "uniqCompNum": 15,
    "screenshot": "assets/images/blueprint-horn.jpg",
    "favicon": "assets/images/waard-original-mark.png",
    "includeGoogleFonts": true
  },
  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "WAARD — Creative Research, Engineering & Design",
        "meta_descr": "Creative problem-solving across acoustics, electronics, software, user interfaces and prototyping. Wavecraft Applied Acoustical Research and Development (WAARD).",
        "header_custom": "<meta name=\"color-scheme\" content=\"dark\"><style id=\"waard-page-styles\">\n/* WAARD Blueprint Studio 2026: custom Mobirise styles. Safe to edit in Page Settings > Custom HTML. */\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n:root{--night:#06141f;--navy:#0a1f2d;--navy2:#102b3b;--ink:#e9f1ee;--paper:#f2f1ea;--muted:#9bb7bd;--soft:#b3cbd0;--cyan:#78dbe7;--copper:#dab989;--slate:#4f8495;--line:rgba(133,188,197,.24);--grid:rgba(93,157,172,.095);--ff:'DM Sans','Segoe UI',Arial,sans-serif;--hd:'Space Grotesk','Segoe UI',Arial,sans-serif;--mono:'IBM Plex Mono',Consolas,'Courier New',monospace}\n*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:94px}body{margin:0;min-width:320px;background:var(--night);color:var(--ink);font-family:var(--ff);line-height:1.55;overflow-x:hidden}body.menu-open{overflow:hidden}.waard-site{position:relative;overflow:hidden}.waard-site h1,.waard-site h2,.waard-site h3,.waard-site h4{font-family:var(--hd);letter-spacing:-.04em;line-height:1.06;margin:0;font-weight:600}.waard-site p{margin:0}.waard-site a{color:inherit;text-decoration:none}.waard-site img{max-width:100%;display:block}.waard-site button,.waard-site input,.waard-site textarea{font:inherit}.waard-site button{cursor:pointer}.waard-site :focus-visible{outline:2px solid var(--cyan);outline-offset:4px}.w-wrap{max-width:1280px;padding:0 42px;margin:0 auto}.w-mono{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.13em;text-transform:uppercase}.w-kicker{font:500 11px/1.4 var(--mono);color:var(--cyan);letter-spacing:.21em;text-transform:uppercase;display:flex;align-items:center;gap:15px}.w-kicker:before{content:'';width:30px;height:1px;background:var(--cyan)}.w-btn{min-height:49px;padding:14px 22px;border:1px solid var(--cyan);background:var(--cyan);color:#08202b!important;border-radius:2px;font:600 11px/1.2 var(--mono);text-transform:uppercase;letter-spacing:.12em;display:inline-flex;align-items:center;gap:18px;justify-content:center;transition:transform .2s,background .2s,border-color .2s}.w-btn:hover{background:#adf2f0;border-color:#adf2f0;transform:translateY(-2px)}.w-btn--ghost{background:transparent!important;color:var(--ink)!important;border-color:rgba(161,201,208,.44)}.w-btn--ghost:hover{border-color:var(--cyan)}.w-outline{color:transparent;-webkit-text-stroke:1px rgba(188,235,238,.72)}.w-rule{border-top:1px solid var(--line)}.w-grid{background-image:linear-gradient(90deg,var(--grid) 1px,transparent 1px),linear-gradient(0deg,var(--grid) 1px,transparent 1px);background-size:35px 35px}.w-sectionhead{max-width:760px}.w-sectionhead h2{font-size:clamp(35px,5.2vw,72px);margin-top:19px}.w-sectionhead p{font-size:clamp(16px,1.6vw,19px);line-height:1.65;color:var(--soft);margin-top:22px;max-width:640px}\n/* header */\n.section-nav{position:sticky;top:0;z-index:50;background:rgba(5,18,28,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);overflow:visible}.nav-shell{height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px}.w-brand{display:flex;gap:13px;align-items:center;min-width:260px}.w-brandicon{display:grid;place-items:center;width:43px;height:43px;border:1px solid var(--cyan);color:var(--cyan);font:700 20px var(--hd);letter-spacing:-.1em;position:relative}.w-brandicon:after{content:'';width:6px;height:6px;background:var(--copper);position:absolute;bottom:-4px;right:-4px}.w-brandtext{display:flex;flex-direction:column;line-height:1.05}.w-brandtext b{font:700 24px var(--hd);letter-spacing:.06em}.w-brandtext small{color:#adc4c8;font:500 8px/1.7 var(--mono);letter-spacing:.075em;text-transform:uppercase}.nav-links{display:flex;align-items:center;gap:26px}.nav-links>a{font:500 11px var(--mono);letter-spacing:.045em;color:#b6cad0;transition:color .2s}.nav-links>a:hover,.nav-links>a:focus{color:var(--cyan)}.nav-links>a.nav-cta{border:1px solid rgba(120,219,231,.75);padding:12px 15px;color:var(--cyan)}.nav-toggle{display:none;border:1px solid var(--line);background:none;color:var(--ink);font-size:25px;line-height:1;padding:8px 12px}\n/* hero */\n.section-hero{min-height:725px;background:#051623}.hero-media{position:absolute;inset:0;left:22%;background-image:linear-gradient(90deg,#051623 0%,rgba(5,22,35,.80) 20%,rgba(5,22,35,.16) 60%,rgba(5,22,35,.18) 100%),linear-gradient(0deg,#051623 0%,rgba(5,22,35,0) 25%,rgba(5,22,35,0) 78%,#051623 100%),url('data:image/jpeg;base64,');background-size:cover,cover,cover;background-position:center,right,center;filter:saturate(.89)}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,20,31,.85),transparent 85%)}.hero-shell{position:relative;padding-top:112px;padding-bottom:132px;min-height:725px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.hero-eyebrow{margin-bottom:30px}.hero-title{font-size:clamp(50px,7.1vw,104px);max-width:910px;line-height:.99!important;letter-spacing:-.065em!important}.hero-title em{font-style:normal;color:var(--cyan)}.hero-blurb{font-size:clamp(17px,1.75vw,21px);line-height:1.52;color:#d4e4e6;max-width:560px;margin-top:29px!important;text-shadow:0 1px 10px rgba(0,0,0,.3)}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.hero-foot{position:absolute;bottom:35px;left:42px;right:42px;display:flex;justify-content:space-between;gap:15px;border-top:1px solid rgba(147,205,213,.37);padding-top:15px;color:#b8d1d5}.hero-foot span{max-width:60%}.hero-foot span:last-child{text-align:right}.hero-microlabel{position:absolute;right:46px;top:123px;transform:rotate(90deg) translateX(100%);transform-origin:right top;color:#bed2d9;opacity:.6}.hero-decoration{position:absolute;width:320px;height:320px;right:-120px;bottom:-130px;border:1px solid rgba(120,219,231,.15);border-radius:50%;box-shadow:0 0 0 60px rgba(120,219,231,.025),0 0 0 120px rgba(120,219,231,.025)}\n/* manifesto */\n.section-approach{background:#f0f0e8;color:#102634;padding:108px 0 104px}.section-approach .w-kicker{color:#446d79}.section-approach .w-kicker:before{background:#446d79}.approach-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:10%;align-items:center}.approach-copy h2{font-size:clamp(42px,6vw,83px);margin-top:26px;max-width:780px}.approach-copy h2 span{color:#7c9596}.approach-copy>p{margin-top:24px;font-size:19px;color:#354d54;max-width:630px;line-height:1.7}.approach-aside{border-left:1px solid #b3c9ca;padding-left:46px}.approach-note{display:grid;grid-template-columns:45px 1fr;gap:17px;padding:22px 0;border-bottom:1px solid #c6d3d2}.approach-note:first-child{border-top:1px solid #c6d3d2}.approach-note .num{color:#708f9a;font:13px var(--mono)}.approach-note h3{font-size:20px;margin-bottom:5px}.approach-note p{color:#4c6269;font-size:14px;line-height:1.6}\n/* capabilities */\n.section-capabilities{background:#081c29;padding:113px 0 118px}.cap-header{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:46px}.cap-header .w-sectionhead{max-width:720px}.cap-side{font:11px var(--mono);text-transform:uppercase;letter-spacing:.13em;color:#9dbdc7;max-width:220px}.cap-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border:1px solid var(--line);background:var(--line)}.cap-card{background:#0b2230;padding:34px 30px 32px;min-height:300px;display:flex;flex-direction:column;position:relative;transition:background .22s}.cap-card:hover{background:#113040}.cap-card.featured{grid-column:span 2;background:linear-gradient(130deg,#123441,#092330 75%);min-height:315px;overflow:hidden}.cap-card.featured:after{content:'?';position:absolute;right:24px;bottom:-105px;font:500 340px var(--hd);color:rgba(121,216,222,.1);pointer-events:none}.cap-top{display:flex;justify-content:space-between;align-items:center;color:#8caeb9}.cap-symbol{font:500 38px var(--hd);color:var(--copper);line-height:1}.cap-num{font:11px var(--mono);letter-spacing:.13em}.cap-card h3{font-size:clamp(24px,2.5vw,33px);letter-spacing:-.045em;margin-top:auto;margin-bottom:12px;position:relative;z-index:1}.cap-card p{font-size:15px;line-height:1.7;color:#b6cdd0;position:relative;z-index:1;max-width:530px}.cap-card.featured h3{font-size:clamp(29px,3.6vw,48px)}\n/* practice */\n.section-metgnome{background:#0b2736;padding:110px 0;overflow:hidden}.meta-grid{display:grid;grid-template-columns:.83fr 1.17fr;gap:8%;align-items:center}.meta-copy h2{font-size:clamp(42px,5.2vw,72px);margin:23px 0}.meta-copy p{color:#bad2d5;font-size:18px;line-height:1.75}.meta-tag{display:inline-flex;border:1px solid var(--line);padding:10px 12px;font:500 11px var(--mono);text-transform:uppercase;letter-spacing:.13em;color:var(--copper);margin-top:27px}.meta-art{position:relative;border:1px solid #4f8894;padding:12px;background:#061b27;box-shadow:35px 35px 0 rgba(7,19,29,.36)}.meta-art img{width:100%}.meta-art figcaption{font:10px/1.6 var(--mono);letter-spacing:.08em;color:#91bdc5;padding:12px 6px 2px}\n/* gallery */\n.section-lab{background:#071a27;padding:105px 0 110px}.lab-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:16px;margin-top:46px}.lab-item{border:1px solid var(--line);background:#0c2533;min-width:0}.lab-item .lab-img{aspect-ratio:1/1;overflow:hidden;background:#09202c}.lab-item .lab-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.lab-item:hover .lab-img img{transform:scale(1.035)}.lab-item:first-child .lab-img{aspect-ratio:1/1}.lab-item .lab-caption{padding:19px 21px 23px}.lab-item .lab-caption strong{display:block;font:600 21px var(--hd);margin:10px 0 7px;letter-spacing:-.035em}.lab-item .lab-caption p{font:14px/1.65 var(--ff);color:#a9c2c8}.lab-item .lab-caption .w-mono{color:var(--cyan)}\n/* process */\n.section-method{background:#e9ebe5;color:#102430;padding:115px 0}.section-method .w-kicker{color:#4c7180}.section-method .w-kicker:before{background:#4c7180}.section-method .w-sectionhead p{color:#516b72}.method-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #a7b9bc;margin-top:59px}.method-item{border-right:1px solid #bbc8c8;padding:26px 25px 14px 0;margin-right:27px}.method-item:last-child{border-right:none;margin-right:0}.method-num{font:13px var(--mono);color:#568494;display:block;margin-bottom:84px}.method-item h3{font-size:29px}.method-item p{margin-top:14px;font-size:15px;color:#496169;line-height:1.68}\n/* calculator */\n.section-calculator{background:#0b2230;padding:105px 0 125px}.calc-wrap{display:grid;grid-template-columns:390px 1fr;gap:24px;margin-top:49px}.calc-form,.calc-results{border:1px solid var(--line);background:#102a3a;padding:29px}.calc-title{font:500 11px var(--mono);text-transform:uppercase;letter-spacing:.11em;color:var(--cyan);display:block;margin-bottom:25px}.w-units{display:flex;border:1px solid var(--line);margin-bottom:28px}.w-units label{width:50%;position:relative;text-align:center;cursor:pointer}.w-units input{position:absolute;opacity:0}.w-units span{display:block;padding:12px;font:11px var(--mono);letter-spacing:.06em}.w-units input:checked+span{background:var(--cyan);color:#09212d}.w-units input:focus-visible+span{outline:2px solid #fff;outline-offset:2px}.w-field{margin:17px 0}.w-field label{display:block;color:#d5e4e5;font:11px var(--mono);letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}.w-field input{width:100%;border:1px solid #456879;background:#071c2a;color:#f1f7f6;padding:11px 13px;font:16px var(--mono);border-radius:1px}.w-field small{display:block;color:#89a9b3;font-size:12px;line-height:1.55;margin-top:7px}.w-caveat{font-size:12px;color:#a3bdc5;line-height:1.65;margin-top:26px!important}.w-legend{display:flex;gap:18px;flex-wrap:wrap;margin:18px 0}.w-legend span{display:flex;align-items:center;gap:7px;font:11px var(--mono);color:#b7cbd0}.w-legend i{display:inline-block;width:16px;height:4px}.w-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin:24px 0}.w-facts>div{background:#092230;padding:19px 14px;min-width:0}.w-facts .v{font:600 clamp(19px,2.25vw,29px) var(--hd);color:var(--cyan);white-space:nowrap}.w-facts .k{font:10px/1.5 var(--mono);color:#b3c9ce;margin-top:7px}.w-axial{width:100%;border-collapse:collapse;color:#e2eae8;font:12px var(--mono)}.w-axial th,.w-axial td{padding:10px 7px;text-align:left;border-bottom:1px solid var(--line)}.w-axial th{color:#9cbec5;font-weight:500}.w-notes{padding-left:17px;color:#bbd0d3;font-size:13px;line-height:1.65}.w-notes li{margin:9px 0}.w-notes li.ok{color:#a6cfd2}.calc-fineprint{font:11px/1.6 var(--mono);color:#8eacb5;margin-top:18px!important}\n/* inquiry */\n.section-contact{background:#061622;padding:105px 0 98px}.contact-grid{display:grid;grid-template-columns:1fr .84fr;gap:11%;align-items:start}.contact-grid h2{font-size:clamp(50px,6.7vw,87px);margin:19px 0 22px}.contact-grid h2 em{font-style:normal;color:var(--cyan)}.contact-grid p{font-size:18px;color:#b6cbd0;line-height:1.7;max-width:540px}.contact-line{display:flex;gap:15px;align-items:center;margin-top:38px;color:#bad5d8;font:11px var(--mono);letter-spacing:.09em}.contact-line:before{content:'';width:35px;height:1px;background:var(--copper)}.brief-card{border:1px solid var(--line);padding:31px;background:#102a37}.brief-card label{display:block;font:11px var(--mono);letter-spacing:.15em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px}.brief-card textarea{display:block;width:100%;min-height:200px;resize:vertical;background:#061b28;border:1px solid #466a76;color:#dce8e9;padding:17px;line-height:1.65;font-size:15px}.brief-card .w-btn{margin-top:15px;width:100%}.brief-status{font:12px var(--mono);color:#a4c3ca;min-height:25px;margin-top:12px!important}.contact-caveat{font:12px/1.65 var(--ff)!important;color:#90adb7!important;margin-top:19px!important}\n/* footer */\n.section-footer{background:#04111a;border-top:1px solid var(--line)}.footer-grid{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:25px;padding-top:34px;padding-bottom:36px}.footer-main{display:flex;flex-direction:column;gap:8px}.footer-main strong{font:700 24px var(--hd);letter-spacing:.08em}.footer-main small{font:10px var(--mono);letter-spacing:.08em;color:#92b2b9;text-transform:uppercase}.footer-side{font:11px/1.9 var(--mono);color:#a4c1c7;text-align:right}.footer-side a{text-decoration:underline;text-underline-offset:4px;color:var(--cyan)!important}\n@media(max-width:1060px){.nav-links{gap:15px}.w-brand{min-width:200px}.w-brandtext small{font-size:7px}.calc-wrap{grid-template-columns:340px 1fr}.meta-grid{gap:5%}.w-wrap{padding:0 30px}.hero-foot{left:30px;right:30px}}\n@media(max-width:800px){.section-nav{overflow:visible}.nav-shell{height:72px}.nav-toggle{display:block}.nav-links{display:none;position:absolute;top:71px;left:0;right:0;background:#061721;border-bottom:1px solid var(--line);padding:25px 30px;flex-direction:column;align-items:stretch;gap:22px;box-shadow:0 15px 30px #0008}.nav-links.open{display:flex}.nav-links>a{font-size:14px}.nav-links>a.nav-cta{text-align:center}.hero-title{font-size:clamp(50px,11vw,85px)}.hero-media{left:0;opacity:.8;background-position:center}.hero-shell{min-height:700px;padding-top:80px}.hero-foot{position:static;margin-top:85px;width:100%}.hero-microlabel{display:none}.approach-grid,.meta-grid,.contact-grid{grid-template-columns:1fr;gap:45px}.approach-aside{padding-left:26px}.cap-grid{grid-template-columns:repeat(2,1fr)}.cap-card.featured{grid-column:span 2}.lab-grid{grid-template-columns:repeat(2,1fr)}.lab-item:first-child{grid-column:span 2}.lab-item:first-child .lab-img{aspect-ratio:16/8}.method-list{grid-template-columns:repeat(2,1fr)}.method-item{margin-bottom:20px}.method-item:nth-child(2){border-right:none}.method-num{margin-bottom:42px}.calc-wrap{grid-template-columns:1fr}.cap-side{display:none}}\n@media(max-width:520px){.w-wrap{padding:0 20px}.w-brand{min-width:0}.w-brandtext b{font-size:20px}.w-brandtext small{font-size:6.5px}.w-brandicon{width:39px;height:39px}.hero-shell{min-height:715px;padding-top:68px;padding-bottom:36px}.hero-title{font-size:clamp(47px,11.5vw,69px)}.hero-blurb{font-size:16px}.hero-actions{width:100%}.w-btn{width:100%}.hero-foot{margin-top:auto;padding-top:17px;flex-direction:column}.hero-foot span{max-width:100%}.hero-foot span:last-child{text-align:left}.section-approach,.section-capabilities,.section-metgnome,.section-lab,.section-method,.section-calculator,.section-contact{padding-top:76px;padding-bottom:80px}.approach-copy h2{font-size:42px}.approach-aside{padding-left:18px}.cap-grid{grid-template-columns:1fr}.cap-card.featured{grid-column:span 1}.cap-card{min-height:245px}.lab-grid{grid-template-columns:1fr}.lab-item:first-child{grid-column:span 1}.lab-item:first-child .lab-img{aspect-ratio:1/1}.method-list{grid-template-columns:1fr}.method-item{border-right:none;border-bottom:1px solid #bbc8c8;margin-right:0;padding-bottom:35px}.method-num{margin-bottom:25px}.calc-form,.calc-results{padding:19px}.w-facts .v{font-size:19px}.w-facts .k{font-size:9px}.brief-card{padding:20px}.footer-side{text-align:left}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.w-btn,.cap-card,.lab-item img{transition:none}}\n\n</style>",
        "footer_custom": "<script>\n(function(){'use strict';\n  const navToggle=document.getElementById('navToggle'),nav=document.getElementById('navLinks');\n  if(navToggle&&nav){navToggle.addEventListener('click',()=>{const expanded=nav.classList.toggle('open');navToggle.setAttribute('aria-expanded',String(expanded));navToggle.setAttribute('aria-label',expanded?'Close navigation':'Open navigation');navToggle.textContent=expanded?'×':'☰';});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');navToggle.textContent='☰';navToggle.setAttribute('aria-expanded','false');}));}\n  const copy=document.getElementById('copyBrief');if(copy)copy.addEventListener('click',async()=>{let value=document.getElementById('challengeText').value.trim();let status=document.getElementById('briefStatus');if(!value){status.textContent='Write a few sentences first, then copy the brief.';return;}try{await navigator.clipboard.writeText(value);status.textContent='Brief copied. Paste it into your email to WAARD.';}catch(e){let field=document.getElementById('challengeText');field.focus();field.select();status.textContent='Select and copy the highlighted text.';}});\n  const $=id=>document.getElementById(id);if(!$('roomForm'))return;\n  const C=343,FT=.3048;let unit='m';\n  function modes(L,W,H,max){let a=[];for(let x=0;x<=30;x++)for(let y=0;y<=30;y++)for(let z=0;z<=30;z++){if(!x&&!y&&!z)continue;let f=C/2*Math.sqrt((x/L)**2+(y/W)**2+(z/H)**2);if(f>max)continue;let n=(x>0)+(y>0)+(z>0);a.push({f,x,y,z,type:n===1?'axial':n===2?'tangential':'oblique'});}return a.sort((a,b)=>a.f-b.f);}\n  function draw(){const val=id=>{let v=parseFloat($(id).value);return Number.isFinite(v)&&v>0?v:null;},k=unit==='ft'?FT:1;let L=val('len'),W=val('wid'),H=val('hei'),T=val('rt');if(!L||!W||!H){$('notes').innerHTML='<li>Enter positive dimensions for all three sides of the room.</li>';return;}L*=k;W*=k;H*=k;T=T&&T<10?T:.4;let modesAll=modes(L,W,H,300),V=L*W*H,fs=2000*Math.sqrt(T/V),svg=$('spec'),W0=Math.max(330,Math.min(760,Math.round(svg.getBoundingClientRect().width)||640)),x0=34,x1=W0-16,base=133;svg.setAttribute('viewBox',`0 0 ${W0} 170`);\n   const lx=f=>x0+(Math.log(f/20)/Math.log(300/20))*(x1-x0),colors={axial:'#dab989',tangential:'#4f8495',oblique:'#9bb7bd'},heights={axial:101,tangential:68,oblique:39};let s='';\n   for(let f of [20,30,50,100,200,300])s+=`<line x1=\"${lx(f)}\" y1=\"9\" x2=\"${lx(f)}\" y2=\"${base}\" stroke=\"#416272\" stroke-dasharray=\"2 7\"/><text x=\"${lx(f)}\" y=\"${base+23}\" text-anchor=\"middle\" font-family=\"monospace\" font-size=\"11\" fill=\"#adbdc8\">${f}</text>`;\n   s+=`<line x1=\"${x0}\" y1=\"${base}\" x2=\"${x1}\" y2=\"${base}\" stroke=\"#acced4\"/>`;\n   for(let m of modesAll.slice().reverse()){if(m.f<20)continue;s+=`<line x1=\"${lx(m.f).toFixed(1)}\" x2=\"${lx(m.f).toFixed(1)}\" y1=\"${base}\" y2=\"${base-heights[m.type]}\" stroke=\"${colors[m.type]}\" stroke-width=\"${m.type==='axial'?2.2:1.0}\"><title>${m.f.toFixed(1)} Hz ${m.type} (${m.x},${m.y},${m.z})</title></line>`;}\n   if(fs>=20&&fs<=300)s+=`<line x1=\"${lx(fs)}\" x2=\"${lx(fs)}\" y1=\"${base}\" y2=\"8\" stroke=\"#78dbe7\" stroke-width=\"1.3\" stroke-dasharray=\"4 4\"/>`;\n   svg.innerHTML=s;\n   $('fFirst').textContent=modesAll.length?Math.round(modesAll[0].f)+' Hz':'above 300 Hz';$('fCount').textContent=String(modesAll.filter(m=>m.f<=200).length);$('fSch').textContent=Math.round(fs)+' Hz';\n   const rows=[['Length',L],['Width',W],['Height',H]].map(([name,d])=>`<tr><td>${name}</td>${[1,2,3].map(n=>`<td>${(n*C/(2*d)).toFixed(1)}</td>`).join('')}</tr>`).join('');$('axialRows').innerHTML=rows;\n   const ax=modesAll.filter(m=>m.type==='axial'),stacks=[];\n   for(let i=0;i<ax.length;i++)for(let j=i+1;j<ax.length;j++){let a=ax[i],b=ax[j],axisA=a.x?'x':a.y?'y':'z',axisB=b.x?'x':b.y?'y':'z';if(axisA!==axisB&&Math.abs(a.f-b.f)/a.f<.05&&a.f<Math.max(fs,120))stacks.push([a,b]);}\n   let notes=[];if(stacks.length){let [a,b]=stacks[0];notes.push(`Two axial modes on different axes sit near ${Math.round((a.f+b.f)/2)} Hz. Depending on position and damping, this can contribute to uneven bass.`);}else notes.push('No cross-axis axial-mode pair within 5% was found in the lower-frequency range checked.');\n   notes.push('This model describes modal frequencies, not the magnitude of what you will hear at a particular seat.');$('notes').innerHTML=notes.map(n=>`<li>${n}</li>`).join('');\n  }\n  ['len','wid','hei','rt'].forEach(id=>$(id).addEventListener('input',draw));document.querySelectorAll('input[name=\"unit\"]').forEach(el=>el.addEventListener('change',()=>{let next=el.value,ratio=unit==='m'&&next==='ft'?1/FT:unit==='ft'&&next==='m'?FT:1;['len','wid','hei'].forEach(id=>{let n=parseFloat($(id).value);if(Number.isFinite(n))$(id).value=(n*ratio).toFixed(2);});unit=next;draw();}));$('roomForm').addEventListener('submit',e=>{e.preventDefault();draw();});window.addEventListener('resize',draw);draw();\n})();\n</script>",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {},
          "_name": "menu1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-nav\" id=\"nav\">\n<style id=\"waard-edit-preview\">\n/* WAARD Blueprint Studio 2026: custom Mobirise styles. Safe to edit in Page Settings > Custom HTML. */\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n:root{--night:#06141f;--navy:#0a1f2d;--navy2:#102b3b;--ink:#e9f1ee;--paper:#f2f1ea;--muted:#9bb7bd;--soft:#b3cbd0;--cyan:#78dbe7;--copper:#dab989;--slate:#4f8495;--line:rgba(133,188,197,.24);--grid:rgba(93,157,172,.095);--ff:'DM Sans','Segoe UI',Arial,sans-serif;--hd:'Space Grotesk','Segoe UI',Arial,sans-serif;--mono:'IBM Plex Mono',Consolas,'Courier New',monospace}\n*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:94px}body{margin:0;min-width:320px;background:var(--night);color:var(--ink);font-family:var(--ff);line-height:1.55;overflow-x:hidden}body.menu-open{overflow:hidden}.waard-site{position:relative;overflow:hidden}.waard-site h1,.waard-site h2,.waard-site h3,.waard-site h4{font-family:var(--hd);letter-spacing:-.04em;line-height:1.06;margin:0;font-weight:600}.waard-site p{margin:0}.waard-site a{color:inherit;text-decoration:none}.waard-site img{max-width:100%;display:block}.waard-site button,.waard-site input,.waard-site textarea{font:inherit}.waard-site button{cursor:pointer}.waard-site :focus-visible{outline:2px solid var(--cyan);outline-offset:4px}.w-wrap{max-width:1280px;padding:0 42px;margin:0 auto}.w-mono{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.13em;text-transform:uppercase}.w-kicker{font:500 11px/1.4 var(--mono);color:var(--cyan);letter-spacing:.21em;text-transform:uppercase;display:flex;align-items:center;gap:15px}.w-kicker:before{content:'';width:30px;height:1px;background:var(--cyan)}.w-btn{min-height:49px;padding:14px 22px;border:1px solid var(--cyan);background:var(--cyan);color:#08202b!important;border-radius:2px;font:600 11px/1.2 var(--mono);text-transform:uppercase;letter-spacing:.12em;display:inline-flex;align-items:center;gap:18px;justify-content:center;transition:transform .2s,background .2s,border-color .2s}.w-btn:hover{background:#adf2f0;border-color:#adf2f0;transform:translateY(-2px)}.w-btn--ghost{background:transparent!important;color:var(--ink)!important;border-color:rgba(161,201,208,.44)}.w-btn--ghost:hover{border-color:var(--cyan)}.w-outline{color:transparent;-webkit-text-stroke:1px rgba(188,235,238,.72)}.w-rule{border-top:1px solid var(--line)}.w-grid{background-image:linear-gradient(90deg,var(--grid) 1px,transparent 1px),linear-gradient(0deg,var(--grid) 1px,transparent 1px);background-size:35px 35px}.w-sectionhead{max-width:760px}.w-sectionhead h2{font-size:clamp(35px,5.2vw,72px);margin-top:19px}.w-sectionhead p{font-size:clamp(16px,1.6vw,19px);line-height:1.65;color:var(--soft);margin-top:22px;max-width:640px}\n/* header */\n.section-nav{position:sticky;top:0;z-index:50;background:rgba(5,18,28,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);overflow:visible}.nav-shell{height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px}.w-brand{display:flex;gap:13px;align-items:center;min-width:260px}.w-brandicon{display:grid;place-items:center;width:43px;height:43px;border:1px solid var(--cyan);color:var(--cyan);font:700 20px var(--hd);letter-spacing:-.1em;position:relative}.w-brandicon:after{content:'';width:6px;height:6px;background:var(--copper);position:absolute;bottom:-4px;right:-4px}.w-brandtext{display:flex;flex-direction:column;line-height:1.05}.w-brandtext b{font:700 24px var(--hd);letter-spacing:.06em}.w-brandtext small{color:#adc4c8;font:500 8px/1.7 var(--mono);letter-spacing:.075em;text-transform:uppercase}.nav-links{display:flex;align-items:center;gap:26px}.nav-links>a{font:500 11px var(--mono);letter-spacing:.045em;color:#b6cad0;transition:color .2s}.nav-links>a:hover,.nav-links>a:focus{color:var(--cyan)}.nav-links>a.nav-cta{border:1px solid rgba(120,219,231,.75);padding:12px 15px;color:var(--cyan)}.nav-toggle{display:none;border:1px solid var(--line);background:none;color:var(--ink);font-size:25px;line-height:1;padding:8px 12px}\n/* hero */\n.section-hero{min-height:725px;background:#051623}.hero-media{position:absolute;inset:0;left:22%;background-image:linear-gradient(90deg,#051623 0%,rgba(5,22,35,.80) 20%,rgba(5,22,35,.16) 60%,rgba(5,22,35,.18) 100%),linear-gradient(0deg,#051623 0%,rgba(5,22,35,0) 25%,rgba(5,22,35,0) 78%,#051623 100%),url('data:image/jpeg;base64,');background-size:cover,cover,cover;background-position:center,right,center;filter:saturate(.89)}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,20,31,.85),transparent 85%)}.hero-shell{position:relative;padding-top:112px;padding-bottom:132px;min-height:725px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.hero-eyebrow{margin-bottom:30px}.hero-title{font-size:clamp(50px,7.1vw,104px);max-width:910px;line-height:.99!important;letter-spacing:-.065em!important}.hero-title em{font-style:normal;color:var(--cyan)}.hero-blurb{font-size:clamp(17px,1.75vw,21px);line-height:1.52;color:#d4e4e6;max-width:560px;margin-top:29px!important;text-shadow:0 1px 10px rgba(0,0,0,.3)}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.hero-foot{position:absolute;bottom:35px;left:42px;right:42px;display:flex;justify-content:space-between;gap:15px;border-top:1px solid rgba(147,205,213,.37);padding-top:15px;color:#b8d1d5}.hero-foot span{max-width:60%}.hero-foot span:last-child{text-align:right}.hero-microlabel{position:absolute;right:46px;top:123px;transform:rotate(90deg) translateX(100%);transform-origin:right top;color:#bed2d9;opacity:.6}.hero-decoration{position:absolute;width:320px;height:320px;right:-120px;bottom:-130px;border:1px solid rgba(120,219,231,.15);border-radius:50%;box-shadow:0 0 0 60px rgba(120,219,231,.025),0 0 0 120px rgba(120,219,231,.025)}\n/* manifesto */\n.section-approach{background:#f0f0e8;color:#102634;padding:108px 0 104px}.section-approach .w-kicker{color:#446d79}.section-approach .w-kicker:before{background:#446d79}.approach-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:10%;align-items:center}.approach-copy h2{font-size:clamp(42px,6vw,83px);margin-top:26px;max-width:780px}.approach-copy h2 span{color:#7c9596}.approach-copy>p{margin-top:24px;font-size:19px;color:#354d54;max-width:630px;line-height:1.7}.approach-aside{border-left:1px solid #b3c9ca;padding-left:46px}.approach-note{display:grid;grid-template-columns:45px 1fr;gap:17px;padding:22px 0;border-bottom:1px solid #c6d3d2}.approach-note:first-child{border-top:1px solid #c6d3d2}.approach-note .num{color:#708f9a;font:13px var(--mono)}.approach-note h3{font-size:20px;margin-bottom:5px}.approach-note p{color:#4c6269;font-size:14px;line-height:1.6}\n/* capabilities */\n.section-capabilities{background:#081c29;padding:113px 0 118px}.cap-header{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:46px}.cap-header .w-sectionhead{max-width:720px}.cap-side{font:11px var(--mono);text-transform:uppercase;letter-spacing:.13em;color:#9dbdc7;max-width:220px}.cap-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border:1px solid var(--line);background:var(--line)}.cap-card{background:#0b2230;padding:34px 30px 32px;min-height:300px;display:flex;flex-direction:column;position:relative;transition:background .22s}.cap-card:hover{background:#113040}.cap-card.featured{grid-column:span 2;background:linear-gradient(130deg,#123441,#092330 75%);min-height:315px;overflow:hidden}.cap-card.featured:after{content:'?';position:absolute;right:24px;bottom:-105px;font:500 340px var(--hd);color:rgba(121,216,222,.1);pointer-events:none}.cap-top{display:flex;justify-content:space-between;align-items:center;color:#8caeb9}.cap-symbol{font:500 38px var(--hd);color:var(--copper);line-height:1}.cap-num{font:11px var(--mono);letter-spacing:.13em}.cap-card h3{font-size:clamp(24px,2.5vw,33px);letter-spacing:-.045em;margin-top:auto;margin-bottom:12px;position:relative;z-index:1}.cap-card p{font-size:15px;line-height:1.7;color:#b6cdd0;position:relative;z-index:1;max-width:530px}.cap-card.featured h3{font-size:clamp(29px,3.6vw,48px)}\n/* practice */\n.section-metgnome{background:#0b2736;padding:110px 0;overflow:hidden}.meta-grid{display:grid;grid-template-columns:.83fr 1.17fr;gap:8%;align-items:center}.meta-copy h2{font-size:clamp(42px,5.2vw,72px);margin:23px 0}.meta-copy p{color:#bad2d5;font-size:18px;line-height:1.75}.meta-tag{display:inline-flex;border:1px solid var(--line);padding:10px 12px;font:500 11px var(--mono);text-transform:uppercase;letter-spacing:.13em;color:var(--copper);margin-top:27px}.meta-art{position:relative;border:1px solid #4f8894;padding:12px;background:#061b27;box-shadow:35px 35px 0 rgba(7,19,29,.36)}.meta-art img{width:100%}.meta-art figcaption{font:10px/1.6 var(--mono);letter-spacing:.08em;color:#91bdc5;padding:12px 6px 2px}\n/* gallery */\n.section-lab{background:#071a27;padding:105px 0 110px}.lab-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:16px;margin-top:46px}.lab-item{border:1px solid var(--line);background:#0c2533;min-width:0}.lab-item .lab-img{aspect-ratio:1/1;overflow:hidden;background:#09202c}.lab-item .lab-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.lab-item:hover .lab-img img{transform:scale(1.035)}.lab-item:first-child .lab-img{aspect-ratio:1/1}.lab-item .lab-caption{padding:19px 21px 23px}.lab-item .lab-caption strong{display:block;font:600 21px var(--hd);margin:10px 0 7px;letter-spacing:-.035em}.lab-item .lab-caption p{font:14px/1.65 var(--ff);color:#a9c2c8}.lab-item .lab-caption .w-mono{color:var(--cyan)}\n/* process */\n.section-method{background:#e9ebe5;color:#102430;padding:115px 0}.section-method .w-kicker{color:#4c7180}.section-method .w-kicker:before{background:#4c7180}.section-method .w-sectionhead p{color:#516b72}.method-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #a7b9bc;margin-top:59px}.method-item{border-right:1px solid #bbc8c8;padding:26px 25px 14px 0;margin-right:27px}.method-item:last-child{border-right:none;margin-right:0}.method-num{font:13px var(--mono);color:#568494;display:block;margin-bottom:84px}.method-item h3{font-size:29px}.method-item p{margin-top:14px;font-size:15px;color:#496169;line-height:1.68}\n/* calculator */\n.section-calculator{background:#0b2230;padding:105px 0 125px}.calc-wrap{display:grid;grid-template-columns:390px 1fr;gap:24px;margin-top:49px}.calc-form,.calc-results{border:1px solid var(--line);background:#102a3a;padding:29px}.calc-title{font:500 11px var(--mono);text-transform:uppercase;letter-spacing:.11em;color:var(--cyan);display:block;margin-bottom:25px}.w-units{display:flex;border:1px solid var(--line);margin-bottom:28px}.w-units label{width:50%;position:relative;text-align:center;cursor:pointer}.w-units input{position:absolute;opacity:0}.w-units span{display:block;padding:12px;font:11px var(--mono);letter-spacing:.06em}.w-units input:checked+span{background:var(--cyan);color:#09212d}.w-units input:focus-visible+span{outline:2px solid #fff;outline-offset:2px}.w-field{margin:17px 0}.w-field label{display:block;color:#d5e4e5;font:11px var(--mono);letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}.w-field input{width:100%;border:1px solid #456879;background:#071c2a;color:#f1f7f6;padding:11px 13px;font:16px var(--mono);border-radius:1px}.w-field small{display:block;color:#89a9b3;font-size:12px;line-height:1.55;margin-top:7px}.w-caveat{font-size:12px;color:#a3bdc5;line-height:1.65;margin-top:26px!important}.w-legend{display:flex;gap:18px;flex-wrap:wrap;margin:18px 0}.w-legend span{display:flex;align-items:center;gap:7px;font:11px var(--mono);color:#b7cbd0}.w-legend i{display:inline-block;width:16px;height:4px}.w-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin:24px 0}.w-facts>div{background:#092230;padding:19px 14px;min-width:0}.w-facts .v{font:600 clamp(19px,2.25vw,29px) var(--hd);color:var(--cyan);white-space:nowrap}.w-facts .k{font:10px/1.5 var(--mono);color:#b3c9ce;margin-top:7px}.w-axial{width:100%;border-collapse:collapse;color:#e2eae8;font:12px var(--mono)}.w-axial th,.w-axial td{padding:10px 7px;text-align:left;border-bottom:1px solid var(--line)}.w-axial th{color:#9cbec5;font-weight:500}.w-notes{padding-left:17px;color:#bbd0d3;font-size:13px;line-height:1.65}.w-notes li{margin:9px 0}.w-notes li.ok{color:#a6cfd2}.calc-fineprint{font:11px/1.6 var(--mono);color:#8eacb5;margin-top:18px!important}\n/* inquiry */\n.section-contact{background:#061622;padding:105px 0 98px}.contact-grid{display:grid;grid-template-columns:1fr .84fr;gap:11%;align-items:start}.contact-grid h2{font-size:clamp(50px,6.7vw,87px);margin:19px 0 22px}.contact-grid h2 em{font-style:normal;color:var(--cyan)}.contact-grid p{font-size:18px;color:#b6cbd0;line-height:1.7;max-width:540px}.contact-line{display:flex;gap:15px;align-items:center;margin-top:38px;color:#bad5d8;font:11px var(--mono);letter-spacing:.09em}.contact-line:before{content:'';width:35px;height:1px;background:var(--copper)}.brief-card{border:1px solid var(--line);padding:31px;background:#102a37}.brief-card label{display:block;font:11px var(--mono);letter-spacing:.15em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px}.brief-card textarea{display:block;width:100%;min-height:200px;resize:vertical;background:#061b28;border:1px solid #466a76;color:#dce8e9;padding:17px;line-height:1.65;font-size:15px}.brief-card .w-btn{margin-top:15px;width:100%}.brief-status{font:12px var(--mono);color:#a4c3ca;min-height:25px;margin-top:12px!important}.contact-caveat{font:12px/1.65 var(--ff)!important;color:#90adb7!important;margin-top:19px!important}\n/* footer */\n.section-footer{background:#04111a;border-top:1px solid var(--line)}.footer-grid{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:25px;padding-top:34px;padding-bottom:36px}.footer-main{display:flex;flex-direction:column;gap:8px}.footer-main strong{font:700 24px var(--hd);letter-spacing:.08em}.footer-main small{font:10px var(--mono);letter-spacing:.08em;color:#92b2b9;text-transform:uppercase}.footer-side{font:11px/1.9 var(--mono);color:#a4c1c7;text-align:right}.footer-side a{text-decoration:underline;text-underline-offset:4px;color:var(--cyan)!important}\n@media(max-width:1060px){.nav-links{gap:15px}.w-brand{min-width:200px}.w-brandtext small{font-size:7px}.calc-wrap{grid-template-columns:340px 1fr}.meta-grid{gap:5%}.w-wrap{padding:0 30px}.hero-foot{left:30px;right:30px}}\n@media(max-width:800px){.section-nav{overflow:visible}.nav-shell{height:72px}.nav-toggle{display:block}.nav-links{display:none;position:absolute;top:71px;left:0;right:0;background:#061721;border-bottom:1px solid var(--line);padding:25px 30px;flex-direction:column;align-items:stretch;gap:22px;box-shadow:0 15px 30px #0008}.nav-links.open{display:flex}.nav-links>a{font-size:14px}.nav-links>a.nav-cta{text-align:center}.hero-title{font-size:clamp(50px,11vw,85px)}.hero-media{left:0;opacity:.8;background-position:center}.hero-shell{min-height:700px;padding-top:80px}.hero-foot{position:static;margin-top:85px;width:100%}.hero-microlabel{display:none}.approach-grid,.meta-grid,.contact-grid{grid-template-columns:1fr;gap:45px}.approach-aside{padding-left:26px}.cap-grid{grid-template-columns:repeat(2,1fr)}.cap-card.featured{grid-column:span 2}.lab-grid{grid-template-columns:repeat(2,1fr)}.lab-item:first-child{grid-column:span 2}.lab-item:first-child .lab-img{aspect-ratio:16/8}.method-list{grid-template-columns:repeat(2,1fr)}.method-item{margin-bottom:20px}.method-item:nth-child(2){border-right:none}.method-num{margin-bottom:42px}.calc-wrap{grid-template-columns:1fr}.cap-side{display:none}}\n@media(max-width:520px){.w-wrap{padding:0 20px}.w-brand{min-width:0}.w-brandtext b{font-size:20px}.w-brandtext small{font-size:6.5px}.w-brandicon{width:39px;height:39px}.hero-shell{min-height:715px;padding-top:68px;padding-bottom:36px}.hero-title{font-size:clamp(47px,11.5vw,69px)}.hero-blurb{font-size:16px}.hero-actions{width:100%}.w-btn{width:100%}.hero-foot{margin-top:auto;padding-top:17px;flex-direction:column}.hero-foot span{max-width:100%}.hero-foot span:last-child{text-align:left}.section-approach,.section-capabilities,.section-metgnome,.section-lab,.section-method,.section-calculator,.section-contact{padding-top:76px;padding-bottom:80px}.approach-copy h2{font-size:42px}.approach-aside{padding-left:18px}.cap-grid{grid-template-columns:1fr}.cap-card.featured{grid-column:span 1}.cap-card{min-height:245px}.lab-grid{grid-template-columns:1fr}.lab-item:first-child{grid-column:span 1}.lab-item:first-child .lab-img{aspect-ratio:1/1}.method-list{grid-template-columns:1fr}.method-item{border-right:none;border-bottom:1px solid #bbc8c8;margin-right:0;padding-bottom:35px}.method-num{margin-bottom:25px}.calc-form,.calc-results{padding:19px}.w-facts .v{font-size:19px}.w-facts .k{font-size:9px}.brief-card{padding:20px}.footer-side{text-align:left}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.w-btn,.cap-card,.lab-item img{transition:none}}\n\n</style>\n<div class=\"w-wrap nav-shell\">\n<a class=\"w-brand\" href=\"#top\" aria-label=\"WAARD home\"><span class=\"w-brandicon\">W</span><span class=\"w-brandtext\"><b>WAARD</b><small>Wavecraft Applied Acoustical<br>Research &amp; Development</small></span></a>\n<button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Open navigation\" aria-controls=\"navLinks\" aria-expanded=\"false\">☰</button>\n<nav class=\"nav-links\" id=\"navLinks\" aria-label=\"Main navigation\"><a href=\"#approach\">Approach</a><a href=\"#capabilities\">Capabilities</a><a href=\"#metgnome\">Interface work</a><a href=\"#lab\">Drawings</a><a href=\"#calculator\">Room calculator</a><a class=\"nav-cta\" href=\"#contact\">Start a conversation ↗</a></nav>\n</div>\n</section>",
          "_cid": "nav",
          "_anchor": "nav",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "header1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-top\" id=\"top\">\n<div class=\"hero-media\" style=\"background-image:linear-gradient(90deg,#051623 0%,rgba(5,22,35,.80) 20%,rgba(5,22,35,.16) 60%,rgba(5,22,35,.18) 100%),linear-gradient(0deg,#051623 0%,rgba(5,22,35,0) 25%,rgba(5,22,35,0) 78%,#051623 100%),url('data:image/jpeg;base64,')\" role=\"img\" aria-label=\"Illustrative blueprint of an acoustic horn and transducer assembly\"></div><div class=\"hero-overlay\" aria-hidden=\"true\"></div><div class=\"hero-decoration\" aria-hidden=\"true\"></div>\n<div class=\"w-wrap hero-shell\">\n<div class=\"w-kicker hero-eyebrow\">Wavecraft / WAARD / Creative R&amp;D</div>\n<h1 class=\"hero-title\">Some problems<br>need a different<br><em>kind of thinking.</em></h1>\n<p class=\"hero-blurb\">Creative problem-solving across acoustics, electronics, software, and user interfaces. When the answer doesn't come off a shelf, we explore what could work—and how to make it real.</p>\n<div class=\"hero-actions\"><a class=\"w-btn\" href=\"#capabilities\">Explore what we do <span aria-hidden=\"true\">↗</span></a><a class=\"w-btn w-btn--ghost\" href=\"#contact\">Bring us a challenge <span aria-hidden=\"true\">→</span></a></div>\n<div class=\"hero-foot w-mono\"><span>Think across disciplines. Design with purpose.</span><span>Concept illustration / Acoustic engineering</span></div>\n</div>\n</section>",
          "_cid": "top",
          "_anchor": "top",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "content1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-approach\" id=\"approach\">\n<div class=\"w-wrap approach-grid\"><div class=\"approach-copy\">\n<div class=\"w-kicker\">The philosophy</div><h2>Begin with the <span>question.</span><br>Not the catalog.</h2>\n<p>Our work starts where a technical challenge meets a human need. A musical instrument may need to feel easier to play. A software experience may need to feel as intuitive as playing music. A rooms sound may need to modify the emotions of the people inside. The useful answer often lives between disciplines.</p>\n</div><div class=\"approach-aside\" aria-label=\"Core design principles\">\n<div class=\"approach-note\"><span class=\"num\">01</span><div><h3>Look closer</h3><p>Understand the actual constraint before deciding what to build.</p></div></div>\n<div class=\"approach-note\"><span class=\"num\">02</span><div><h3>Connect ideas</h3><p>Borrow useful thinking from engineering, design, sound, and code.</p></div></div>\n<div class=\"approach-note\"><span class=\"num\">03</span><div><h3>Make it tangible</h3><p>Move from sketches and models to a testable experience or prototype.</p></div></div>\n</div></div>\n</section>",
          "_cid": "approach",
          "_anchor": "approach",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "features1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-capabilities\" id=\"capabilities\">\n<div class=\"w-wrap\"><div class=\"cap-header\"><div class=\"w-sectionhead\"><div class=\"w-kicker\">What we can work on</div><h2>A studio for problems<br>without neat categories.</h2><p>From the physical behavior of sound to the software people touch, we look for the right combination of disciplines—not a one-size-fits-all deliverable.</p></div><div class=\"cap-side\">Capability areas / Not a list of completed commissions</div></div>\n<div class=\"cap-grid\">\n<article class=\"cap-card featured\"><div class=\"cap-top\"><span class=\"cap-num\">00 / THE THROUGH-LINE</span><span class=\"cap-symbol\">✳</span></div><h3>Creative problem-solving</h3><p>Define unfamiliar challenges, test unconventional approaches, and connect ideas that don't ordinarily share the same drawing board. This is the point of the work—not merely a stage of it.</p></article>\n<article class=\"cap-card\"><div class=\"cap-top\"><span class=\"cap-num\">01 / SOUND</span><span class=\"cap-symbol\">◉</span></div><h3>Acoustics &amp; audio</h3><p>Explore sound generation, propagation, measurement, room behavior, and the relationship between instruments and the people who use them.</p></article>\n<article class=\"cap-card\"><div class=\"cap-top\"><span class=\"cap-num\">02 / HARDWARE</span><span class=\"cap-symbol\">⌁</span></div><h3>Electronics &amp; embedded systems</h3><p>Consider signal paths, circuits, controls, microcontrollers, and hardware/software integration for purpose-built devices.</p></article>\n<article class=\"cap-card\"><div class=\"cap-top\"><span class=\"cap-num\">03 / SOFTWARE</span><span class=\"cap-symbol\">{ }</span></div><h3>Software development</h3><p>Develop software concepts, browser-based tools, interactive features, and the logic that makes a useful digital experience work.</p></article>\n<article class=\"cap-card\"><div class=\"cap-top\"><span class=\"cap-num\">04 / EXPERIENCE</span><span class=\"cap-symbol\">▤</span></div><h3>UI &amp; interaction design</h3><p>Shape navigation, information architecture, on-screen controls, and feedback around what a person is actually trying to do.</p></article>\n<article class=\"cap-card\"><div class=\"cap-top\"><span class=\"cap-num\">05 / FORM</span><span class=\"cap-symbol\">⌗</span></div><h3>Prototypes &amp; physical design</h3><p>Work through housings, mechanical interfaces, accessories, custom fixtures, and iterative builds to explore whether an idea works in practice.</p></article>\n</div></div>\n</section>",
          "_cid": "capabilities",
          "_anchor": "capabilities",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "image3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-metgnome\" id=\"metgnome\">\n<div class=\"w-wrap meta-grid\"><div class=\"meta-copy\"><div class=\"w-kicker\">Interfaces / Creative software</div><h2>Designing for<br><span class=\"w-outline\">human flow.</span></h2>\n<p>A useful interface isn't just attractive. It should make the next action understandable, keep feedback meaningful, and adapt to the way someone thinks. WAARD has also worked on <strong>MetGnome user interfaces</strong>—a meeting point between musical learning, interaction design, and software.</p>\n<div class=\"meta-tag\">MetGnome / User-interface work</div>\n</div><figure class=\"meta-art\"><img src=\"@PROJECT_PATH@/assets/images/interface-map.svg\" width=\"1100\" height=\"720\" loading=\"eager\" alt=\"Illustrative interface study with musical note lanes, player controls, and practice choices\"><figcaption>FIG. 03 / Interface exploration / Concept sketch, not a MetGnome screenshot</figcaption></figure></div>\n</section>",
          "_cid": "metgnome",
          "_anchor": "metgnome",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "gallery1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-lab\" id=\"lab\">\n<div class=\"w-wrap\"><div class=\"w-sectionhead\"><div class=\"w-kicker\">The drawing board</div><h2>Ideas are easier to explore<br>when you can see them.</h2><p>Diagrams, signal paths, interface layouts, and mechanical sketches give abstract problems something to work with. The illustrations below express our areas of interest; they are conceptual, not records of completed products.</p></div>\n<div class=\"lab-grid\">\n<figure class=\"lab-item\"><div class=\"lab-img\"><img src=\"@PROJECT_PATH@/assets/images/wave-map.png\" loading=\"eager\" width=\"920\" height=\"630\" alt=\"Conceptual illustration of acoustic wavefronts leaving a horn\"></div><figcaption class=\"lab-caption\"><span class=\"w-mono\">FIG 01 / Acoustics</span><strong>Follow the energy.</strong><p>Think about how sound moves through a device, instrument, or room—and what changes its behavior.</p></figcaption></figure>\n<figure class=\"lab-item\"><div class=\"lab-img\"><img src=\"@PROJECT_PATH@/assets/images/signal-map.png\" loading=\"eager\" width=\"1000\" height=\"660\" alt=\"Conceptual electronics diagram showing signal routes into and out of a processor\"></div><figcaption class=\"lab-caption\"><span class=\"w-mono\">FIG 02 / Electronics</span><strong>Map the system.</strong><p>Bring together circuits, firmware, mechanics, and real-world use before committing to a solution.</p></figcaption></figure>\n<figure class=\"lab-item\"><div class=\"lab-img\"><img src=\"@PROJECT_PATH@/assets/images/interface-map.png\" loading=\"eager\" width=\"1100\" height=\"720\" alt=\"Conceptual interface wireframe with music note lanes and action buttons\"></div><figcaption class=\"lab-caption\"><span class=\"w-mono\">FIG 03 / Interaction</span><strong>Make complexity usable.</strong><p>Organize a technical system into decisions, interactions, and feedback a person can understand.</p></figcaption></figure>\n</div></div>\n</section>",
          "_cid": "lab",
          "_anchor": "lab",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "features3",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-method\" id=\"method\">\n<div class=\"w-wrap\"><div class=\"w-sectionhead\"><div class=\"w-kicker\">A working method</div><h2>Curiosity, with<br>enough structure to build.</h2><p>The path can change with the project. The goal is to learn what matters early, make ideas testable, and keep refining rather than merely adding complexity.</p></div>\n<div class=\"method-list\"><div class=\"method-item\"><span class=\"method-num\">01 / FRAME</span><h3>Define</h3><p>Describe the real problem, desired experience, and non-negotiable constraints.</p></div><div class=\"method-item\"><span class=\"method-num\">02 / EXPLORE</span><h3>Imagine</h3><p>Consider different ways forward—including the less obvious options.</p></div><div class=\"method-item\"><span class=\"method-num\">03 / TEST</span><h3>Prototype</h3><p>Build just enough to challenge assumptions and reveal what works.</p></div><div class=\"method-item\"><span class=\"method-num\">04 / REFINE</span><h3>Iterate</h3><p>Listen, measure, observe, improve, and simplify whenever possible.</p></div></div></div>\n</section>",
          "_cid": "method",
          "_anchor": "method",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "content1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-calculator\" id=\"calculator\">\n<div class=\"w-wrap\"><div class=\"w-sectionhead\"><div class=\"w-kicker\">Interactive field notebook / Acoustics</div><h2>Explore the low end<br>of a room.</h2><p>One example of how a technical idea becomes a usable tool. Enter the dimensions of a rectangular room to estimate its standing-wave frequencies. This is an illustration—not a substitute for on-site acoustic measurements.</p></div>\n<div class=\"calc-wrap\"><div class=\"calc-form\"><span class=\"calc-title\">01 / Input geometry</span><form id=\"roomForm\" novalidate><div class=\"w-units\" role=\"radiogroup\" aria-label=\"Dimensions unit\"><label><input type=\"radio\" name=\"unit\" id=\"unitM\" value=\"m\" checked><span>METRES</span></label><label><input type=\"radio\" name=\"unit\" id=\"unitFt\" value=\"ft\"><span>FEET</span></label></div>\n<div class=\"w-field\"><label for=\"len\">Length</label><input id=\"len\" type=\"number\" step=\"any\" min=\"0.1\" value=\"5.2\"></div><div class=\"w-field\"><label for=\"wid\">Width</label><input id=\"wid\" type=\"number\" step=\"any\" min=\"0.1\" value=\"3.9\"></div><div class=\"w-field\"><label for=\"hei\">Height</label><input id=\"hei\" type=\"number\" step=\"any\" min=\"0.1\" value=\"2.7\"></div><div class=\"w-field\"><label for=\"rt\">Reverb time (seconds)</label><input id=\"rt\" type=\"number\" step=\"any\" min=\"0.1\" max=\"10\" value=\"0.4\"><small>RT60 estimate for the room. For an illustrative example, use 0.4 seconds.</small></div><p class=\"w-caveat\">Simplified rectangular enclosure / rigid-wall modes / 343 m/s speed of sound. Real rooms vary with boundaries, objects, placement, and treatment.</p></form></div>\n<div class=\"calc-results\" aria-live=\"polite\"><span class=\"calc-title\">02 / Estimated response</span><svg id=\"spec\" viewBox=\"0 0 640 170\" style=\"width:100%;height:auto;display:block\" role=\"img\" aria-label=\"Room mode spectrum from 20 to 300 hertz\"></svg><div class=\"w-legend\"><span><i style=\"background:#dab989\"></i>Axial</span><span><i style=\"background:#4f8495\"></i>Tangential</span><span><i style=\"background:#9bb7bd\"></i>Oblique</span><span><i style=\"background:#78dbe7;width:2px;height:12px\"></i>Schroeder estimate</span></div>\n<div class=\"w-facts\"><div><div class=\"v\" id=\"fFirst\">—</div><div class=\"k\">Lowest mode</div></div><div><div class=\"v\" id=\"fCount\">—</div><div class=\"k\">Modes under 200 Hz</div></div><div><div class=\"v\" id=\"fSch\">—</div><div class=\"k\">Schroeder estimate</div></div></div><div style=\"overflow-x:auto\"><table class=\"w-axial\"><thead><tr><th>Axial frequencies</th><th>1st</th><th>2nd</th><th>3rd</th></tr></thead><tbody id=\"axialRows\"></tbody></table></div><ul id=\"notes\" class=\"w-notes\"></ul><p class=\"calc-fineprint\">A modal-frequency visualization, not a predicted measured frequency response.</p></div></div>\n</div>\n</section>",
          "_cid": "calculator",
          "_anchor": "calculator",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "contacts1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-contact\" id=\"contact\">\n<div class=\"w-wrap contact-grid\"><div><div class=\"w-kicker\">Have a different kind of challenge?</div><h2>Bring the<br><em>what if.</em></h2><p>A sketch, a workflow that feels wrong, a device that doesn't exist yet, or a strange acoustical problem—start with what you're trying to change, and why it matters.</p><div class=\"contact-line\">Technical imagination / Practical questions</div></div>\n<div class=\"brief-card\"><label for=\"challengeText\">Draft a one-paragraph project brief</label><textarea id=\"challengeText\" spellcheck=\"true\" placeholder=\"I'm trying to...\\n\\nThe current limitation is...\\n\\nA successful outcome would look like...\"></textarea><button class=\"w-btn\" type=\"button\" id=\"copyBrief\">Copy your brief ↗</button><p class=\"brief-status\" id=\"briefStatus\" role=\"status\">Use this to prepare your inquiry.</p><p class=\"contact-caveat\">Add your preferred WAARD contact details in Mobirise before publishing. This form prepares text locally; it does not submit or store an inquiry.</p></div></div>\n</section>",
          "_cid": "contact",
          "_anchor": "contact",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "footer1",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"waard-site section-footer\" id=\"footer\">\n<div class=\"w-wrap footer-grid\"><div class=\"footer-main\"><strong>WAARD<span style=\"color:var(--copper)\">.</span></strong><small>Wavecraft Applied Acoustical Research &amp; Development</small></div><div class=\"footer-side\"><div>Creative problem-solving across physical and digital worlds.</div><div>© 2026 WAARD <span style=\"padding:0 9px;color:#44636e\">/</span> <a href=\"#top\">Back to top ↑</a></div></div></div>\n</section>",
          "_cid": "footer",
          "_anchor": "footer",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    }
  }
}